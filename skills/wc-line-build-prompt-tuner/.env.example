# Optional: shared output directory used by all scripts (baseline / llm-output / mismatches).
# Default is ./prompt-tuner-out relative to wherever you run python from.
# Set to any portable path (relative or absolute) you like.
PROMPT_TUNER_OUT_DIR=./prompt-tuner-out

# Optional: read-only prod MongoDB URI for `pull_baseline.py`. Most flows can use the
# MCP `mongodb-prod_*` tools directly without setting this — fill it in only if you
# want to call pull_baseline.py from a plain shell.
PROD_MONGO_URI=mongodb://user:pass@host:27017/recipe-v2?readPreference=secondaryPreferred
